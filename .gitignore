# Node
node_modules/
npm-debug.log*
*.log

# Test output
playwright-report/
blob-report/
playwright/.cache/
test-results/
coverage/

# Local environment / secrets (never commit)
.env
.env.*
!.env.example

# Key and signing material (CLAUDE.md rule 8). Never commit.
*.pem
*.key
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# Per-developer Xcode override (e.g. the Mac's LAN address for a physical iPhone). Never commit.
ios/Config/Local.xcconfig
ios/Config/Local.Release.xcconfig

# Personal Claude Code settings (shared project settings may be committed later, with approval)
.claude/settings.local.json

# macOS / Xcode
.DS_Store
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult
ios/build/

# Local QA evidence (xcresult bundles, xcodebuild logs). Kept on the owner's machine, never committed.
local-evidence/

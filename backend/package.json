{
  "name": "monetalab-backend",
  "version": "0.0.0",
  "private": true,
  "description": "MonetaLab backend (QA portfolio fixture): M1 credits, M2 mock lifecycle, M3 Apple StoreKit verification",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait db",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:migrate": "node src/db/migrate.ts",
    "start": "node src/server.ts",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit:ci": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit.junit.xml \"tests/unit/**/*.test.ts\"",
    "test:integration:ci": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/integration.junit.xml \"tests/integration/**/*.test.ts\"",
    "test:api": "playwright test",
    "test:api:ci": "mkdir -p test-results && PLAYWRIGHT_REPORTS=1 playwright test",
    "db:seed:demo": "node src/db/seed.ts",
    "e2e:server": "node tests/api/support/e2e-server.ts",
    "analytics:report": "node src/analytics/reports.ts",
    "apple:reconcile": "node src/billing/apple/reconcile-cli.ts",
    "notifications:start": "node src/notifications-server.ts",
    "apple:test-notification": "node src/billing/apple/test-notification-cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "jsrsasign": "11.1.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  }
}
